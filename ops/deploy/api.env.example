# =====================================================================
# CloudPosGrid API — üretim ortam değişkenleri (SIRLAR)
# Bu dosyanın gerçek doldurulmuş hâli SUNUCUDA /etc/cloudposgrid/api.env
# olarak durur; git'e ASLA girmez. .NET, "__" ayracını iç içe config
# anahtarına çevirir (ör. Jwt__Secret -> Jwt:Secret).
#
# Kurulum:
#   sudo mkdir -p /etc/cloudposgrid
#   sudo cp api.env.example /etc/cloudposgrid/api.env
#   sudo nano /etc/cloudposgrid/api.env      # değerleri doldur
#   sudo chown root:cloudposgrid /etc/cloudposgrid/api.env
#   sudo chmod 640 /etc/cloudposgrid/api.env
# =====================================================================

# --- Veritabanı (üretim şifresiyle; DİKKAT: "Include Error Detail" YOK) ---
# Maximum Pool Size : eşzamanlı DB bağlantısı tavanı (sel anında sınırsız açılmasın).
# Timeout=15        : bağlantı alma 15 sn'de olmazsa hızlı hata (asılı kalma yok).
# Command Timeout=30: tek sorgu 30 sn'yi geçerse iptal (uzun sorgu kilitlemesin).
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=cloudposgrid;Username=cloudposgrid;Password=BURAYA_DB_SIFRESI;Maximum Pool Size=100;Timeout=15;Command Timeout=30

# --- JWT imza anahtarı (EN AZ 32 karakter, güçlü rastgele) ---
# Üret: openssl rand -base64 48
Jwt__Secret=BURAYA_EN_AZ_32_KARAKTER_GUCLU_RASTGELE_ANAHTAR

# --- Platform (süper-admin) girişi ---
Platform__AdminEmail=emirhancagman6034@gmail.com
Platform__AdminPassword=BURAYA_ADMIN_SIFRESI

# --- Genel erişilebilir API adresi (ZORUNLU) ---
# Yüklenen ürün görsellerinin mutlak URL'i ve pazaryeri (Trendyol) ilan görselleri bundan üretilir.
# BOŞ bırakılırsa nginx ters proxy arkasındaki iç host (127.0.0.1) yansır → Trendyol görsel yüklemesi kırılır.
App__PublicApiUrl=https://api.cloudposgrid.com

# --- E-posta (SMTP) — doğrulama kodu, paket aktivasyon, deneme hatırlatma ---
# Host boş bırakılırsa e-postalar gönderilmez (yalnızca loglanır).
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=BURAYA_SMTP_KULLANICI
Smtp__Password=BURAYA_SMTP_SIFRESI
Smtp__From=CloudPosGrid <noreply@cloudposgrid.com>
Smtp__UseSsl=true

# NOT: Banka/IBAN bilgisi SIR DEĞİL, appsettings.json içinde durur (müşteriye gösterilir).
# NOT: PayTR anahtarları (onay gelirse) buraya eklenecek:
#   Payment__Provider=PayTR
#   PayTR__MerchantId=...   PayTR__MerchantKey=...   PayTR__MerchantSalt=...
